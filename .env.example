# Local development settings. Copy to .env (`make up` does this if .env is missing).
# .env is gitignored. These credentials only protect throwaway containers bound to
# 127.0.0.1; production secrets are managed separately and encrypted.

# Postgres (pgvector) on localhost:5432
POSTGRES_USER=filings
POSTGRES_PASSWORD=filings-local-dev
POSTGRES_DB=filings

# MongoDB on localhost:27017 (root user, authSource=admin)
MONGO_USER=filings
MONGO_PASSWORD=filings-local-dev

# Valkey on localhost:6379 and Redpanda (Kafka API) on localhost:19092 need no credentials locally.

# --- Application settings (read by the services) ---

# SEC requires a User-Agent with a contact email on every request. Required before any SEC call.
SEC_CONTACT_EMAIL=
# SEC_RATE_LIMIT_PER_SECOND=5

DATABASE_URL=postgresql+psycopg://filings:filings-local-dev@localhost:5432/filings
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
MONGODB_URL=mongodb://filings:filings-local-dev@localhost:27017/?authSource=admin

# Raw filings: a local directory in development (gitignored), R2 in production.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_ROOT=data/objects

# LLMs for 8-K summaries. Local model first (an OpenAI-compatible server such as Ollama), then
# Gemini's free tier as fallback. Leave LLM_MODEL unset to use Gemini only.
# `make llm-up` starts Ollama in Docker on the default URL below and pulls llama3.2:3b.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
# Free key from Google AI Studio (no billing). Leave unset to disable Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Semantic search embeddings (an OpenAI-compatible server; `make llm-up` pulls this model).
# Leave unset for keyword-only search. After changing it, run `uv run filings-index`.
# EMBEDDING_MODEL=nomic-embed-text:v1.5

# Sign in with Google: the OAuth client ID ("Web application") from the Google Cloud console.
# It is public (the website embeds it too) and there is no client secret. Unset disables sign-in.
# GOOGLE_CLIENT_ID=
# Browsers send the session cookie (SameSite=Lax) only when the website and the API are on the
# same site: locally, open both on localhost, not one on 127.0.0.1.
# API_SESSION_LIFETIME_DAYS=7
# Secure cookies also work on http://localhost. Turn off only for plain http on another host.
# API_COOKIE_SECURE=true
# The website's exact origins, allowed to call the API with the cookie (a JSON list; never "*").
# API_CORS_ORIGINS=["http://localhost:3000"]

# Email alerts. "log" (default) writes them to the notifier's log instead of sending.
# For real email (e.g. Oracle Cloud Email Delivery, free tier), use smtp:
# EMAIL_BACKEND=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SENDER=

# Telemetry (OpenTelemetry): one trace per filing, from discovery to alert, and the pipeline's
# metrics. Off unless an endpoint is set; then traces go to <endpoint>/v1/traces and metrics to
# <endpoint>/v1/metrics, over OTLP/HTTP. Production sends them to Grafana Cloud's OTLP gateway.
# Locally, `make obs-up` starts a viewer that receives them on the endpoint below: Grafana on
# http://localhost:3001, with the pipeline's dashboards (folder "SEC Filings") and alert rules.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana Cloud only: Authorization=Basic%20<base64 of instance-id:token>. A secret.
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Milliseconds between metric exports (default 60000). Shorter is handy while watching locally.
# OTEL_METRIC_EXPORT_INTERVAL=10000
# To export only one of the two: OTEL_TRACES_EXPORTER=none or OTEL_METRICS_EXPORTER=none.
