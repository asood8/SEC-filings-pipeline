# Local development settings. Copy to .env (`make up` does this if .env is missing).
# .env is gitignored. These credentials only protect throwaway containers bound to
# 127.0.0.1; production secrets are managed separately and encrypted.

# Postgres (pgvector) on localhost:5432
POSTGRES_USER=filings
POSTGRES_PASSWORD=filings-local-dev
POSTGRES_DB=filings

# MongoDB on localhost:27017 (root user, authSource=admin)
MONGO_USER=filings
MONGO_PASSWORD=filings-local-dev

# Valkey on localhost:6379 and Redpanda (Kafka API) on localhost:19092 need no credentials locally.

# --- Application settings (read by the services) ---

# SEC requires a User-Agent with a contact email on every request. Required before any SEC call.
SEC_CONTACT_EMAIL=
# SEC_RATE_LIMIT_PER_SECOND=5

DATABASE_URL=postgresql+psycopg://filings:filings-local-dev@localhost:5432/filings
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
MONGODB_URL=mongodb://filings:filings-local-dev@localhost:27017/?authSource=admin

# Raw filings: a local directory in development (gitignored), R2 in production.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_ROOT=data/objects

# LLMs for 8-K summaries. Local model first (an OpenAI-compatible server such as Ollama), then
# Gemini's free tier as fallback. Leave LLM_MODEL unset to use Gemini only.
# `make llm-up` starts Ollama in Docker on the default URL below and pulls llama3.2:3b.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
# Free key from Google AI Studio (no billing). Leave unset to disable Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Semantic search embeddings (an OpenAI-compatible server; `make llm-up` pulls this model).
# Leave unset for keyword-only search. After changing it, run `uv run filings-index`.
# EMBEDDING_MODEL=nomic-embed-text:v1.5
