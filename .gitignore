# Secrets: local config lives in .env (see .env.example)
.env
.env.*
!.env.example
# Unsealed Kubernetes Secrets: filled-in copies wait here to be sealed and are never committed.
# Only SealedSecrets go into git (deploy/k8s/README.md, "Secrets").
/deploy/k8s/secrets-local/
*.unsealed.yaml
# The sealing key backup (deploy/k8s/README.md): it decrypts every SealedSecret.
*sealed-secrets-key*.yaml

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local raw-filing object store (OBJECT_STORE_LOCAL_ROOT)
/data/

# Terraform (infra/terraform): downloaded providers, state (it holds secrets), variable files
# (they hold credentials; the committed *.tfvars.example files are the templates), plans, and
# crash logs. The dependency lock file, .terraform.lock.hcl, is committed on purpose.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfbackend
!*.tfbackend.example
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
