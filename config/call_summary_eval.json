            "(max|maximum|full|peak)[^.]{0,40}savings[^.]{0,40}(29|2029)"
          ]
        }
      ],
      "forbidden": [
        {
          "claim": "Pace has not produced savings yet",
          "patterns": [
            "\\b(no|not yet|haven't|have not)\\b[^.]{0,20}(seen |produced |delivered )?(any )?savings"
          ]
        }
      ]
    },
