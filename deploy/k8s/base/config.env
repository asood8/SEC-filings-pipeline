# Non-secret settings, given to the services as environment variables (names from
# libs/common/src/filings_common/config.py and the services' own settings classes). Secrets are
# separate Kubernetes Secrets, created from SealedSecrets: see deploy/k8s/secrets-example/.
# The production overlay adds the environment-specific values (overlays/production/config.env).

# The database name. User and password are in the postgres Secret; each workload assembles
# DATABASE_URL from the three.
POSTGRES_DB=filings

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
REDIS_URL=redis://valkey:6379/0
MONGODB_DATABASE=filings

# Raw filings go to Cloudflare R2 (S3 API); endpoint and keys are in the r2-raw-filings Secret.
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_S3_BUCKET=filings-raw
# Nightly pg_dump backups (postgres-backup CronJob), in their own bucket and with their own key.
BACKUP_S3_BUCKET=filings-backups

# 8-K summaries: llama.cpp's server in the cluster first, then Gemini (key in the gemini Secret).
# An 8-K with a long press release (3.8k-token prompt) took about 5 minutes on two laptop cores,
# so the timeout is well above the 180 s default. The summarizer sizes its Kafka poll interval
# from these timeouts (every retry of one filing must fit), so raising this is safe.
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=llama-3.2-3b-instruct-q4_k_m
LLM_PROVIDER_NAME=llama.cpp
LLM_TIMEOUT_SECONDS=600

# Semantic search: the embeddings llama.cpp server.
EMBEDDING_BASE_URL=http://embeddings:8080/v1
EMBEDDING_MODEL=nomic-embed-text-v1.5

# The API is reachable only through Cloudflare Tunnel (the api NetworkPolicy admits cloudflared
# alone), so the client address in CF-Connecting-IP can be trusted.
API_TRUST_PROXY_HEADERS=true

# Traces and metrics go to the in-cluster OpenTelemetry Collector, which forwards them to
# Grafana Cloud.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
