# Production values, merged over ../../base/config.env. The addresses come from Terraform's
# outputs (infra/terraform/README.md, "Secrets into the cluster"); set at launch, 2026-11-13.

OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# The website's origin (`terraform output -raw api_cors_origins`), as a JSON list. The website
# and the API must share a registrable domain for the session cookie (ADR-0013).
API_CORS_ORIGINS=["https://www.filingwire.app"]

# The Google OAuth client ID (public, not a secret; the website embeds it too). Empty disables
# sign-in.
GOOGLE_CLIENT_ID=17344040139-8t393ofhd00vvucr285fqa39l38n6bru.apps.googleusercontent.com

# The website's address (`terraform output -raw web_url`). Alerts link its page for each filing
# and call, with the original beside it; empty links the original only.
ALERTS_SITE_URL=https://www.filingwire.app

# The API's address (`terraform output -raw api_url`). With the unsubscribe Secret, email
# alerts carry one-click unsubscribe links to it; empty, none.
ALERTS_API_URL=https://api.filingwire.app

# Email alerts stay off (logged only) until an SMTP sender is set up: then switch to smtp
# (Oracle Cloud Email Delivery) and create the smtp Secret:
#   EMAIL_BACKEND=smtp
#   EMAIL_SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SENDER=alerts@<domain>
EMAIL_BACKEND=log
