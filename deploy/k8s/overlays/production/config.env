# Production values, merged over ../../base/config.env. The ones marked "Phase 7" wait on
# accounts and a domain that don't exist yet (the project name and domain are an open decision,
# brief §12); until then they keep the features they control switched off or harmless.

OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Phase 7: the website's real origin (Cloudflare Pages custom domain), as a JSON list. The
# website and the API must share a registrable domain for the session cookie (ADR-0013).
API_CORS_ORIGINS=["https://app.example.com"]

# Phase 7: the Google OAuth client ID (public, not a secret). Empty disables sign-in.
GOOGLE_CLIENT_ID=

# Phase 7: switch to smtp (Oracle Cloud Email Delivery) and create the smtp Secret:
#   EMAIL_BACKEND=smtp
#   EMAIL_SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SENDER=alerts@<domain>
EMAIL_BACKEND=log
